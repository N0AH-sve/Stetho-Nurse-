# Copy to .env (never committed): cp .env.example .env && chmod 600 .env
# Variables defined by the specification.

# Host path of the directory mounted on /opt/data in Hermes.
HERMES_DATA_DIR=/path/to/hermes/data
# Actual name of the Hermes container (docker ps).
HERMES_CONTAINER=hermes
DISCORD_WEBHOOK_URL=
STATUS_PASSWORD=
AUTO_ACTIONS=off
PROBE_INTERVAL_SECONDS=30
TZ_DISPLAY=Europe/Paris
